# APEX F1 Analytical Platform - Environment Variables Template
# Copy this file to .env and configure the values.

# ----------------------------------------
# 1. API Configuration
# ----------------------------------------
PORT=3000
ENV=development # Options: development, production, test
DEFAULT_API_KEY=f1_apex_super_secret_dev_key

# ----------------------------------------
# 2. Database Connection
# ----------------------------------------
# Local Dev (Docker): postgresql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apex

# Production: Neon Serverless Postgres ( ap-south-1 Mumbai region )
# DATABASE_URL=postgresql://<user>:<password>@<neon-project-id>.ap-south-1.aws.neon.tech/apex?sslmode=require

# ----------------------------------------
# 3. Cache & Queue Connection
# ----------------------------------------
# Local Dev (Docker)
REDIS_URL=redis://localhost:6379

# Production: Upstash Redis
# REDIS_URL=rediss://default:<password>@<upstash-endpoint>.upstash.io:6379

# ----------------------------------------
# 4. Pipeline Settings (Optional)
# ----------------------------------------
# Limits the number of seasons seeded during local database ingest (e.g. 5 will only fetch 2020-2024 seasons)
# Omit or set to empty to fetch all seasons (1950 to present)
INGEST_SEASONS_LIMIT=5
